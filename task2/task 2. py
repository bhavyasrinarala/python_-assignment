
#include <stdio.h>

int main()
{
    int n, i, units[12];
    float energy, fixed = 50;
    float surcharge, rebate, bill[12];
    float total = 0, increase;

    printf("Enter number of months: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        printf("\nEnter units for month %d: ", i+1);
        scanf("%d", &units[i]);

        // Calculate slab charges
        if(units[i] <= 100)
        {
            energy = units[i] * 2;
        }
        else if(units[i] <= 200)
        {
            energy = 100 * 2 +
                     (units[i] - 100) * 3;
        }
        else if(units[i] <= 300)
        {
            energy = 100 * 2 + 100 * 3 +
                     (units[i] - 200) * 5;
        }
        else
        {
            energy = 100 * 2 + 100 * 3 +
                     100 * 5 +
                     (units[i] - 300) * 7;
        }

        surcharge = energy * 0.05;

        if(units[i] < 100)
            rebate = 20;
        else
            rebate = 0;

        bill[i] = energy + fixed +
                  surcharge - rebate;

        total = total + bill[i];

        printf("\nMonth %d", i+1);
        printf("\nEnergy Charge: Rs.%.2f", energy);
        printf("\nFixed Charge: Rs.%.2f", fixed);
        printf("\nSurcharge: Rs.%.2f", surcharge);
        printf("\nRebate: Rs.%.2f", rebate);
        printf("\nFinal Bill: Rs.%.2f", bill[i]);

        if(i > 0)
        {
            increase = ((bill[i] - bill[i-1])
                        / bill[i-1]) * 100;

            if(increase > 30)
                printf("\nStatus: Unusual Increase");
            else
                printf("\nStatus: Normal Bill");
        }

        printf("\n");
    }

    printf("\nTotal Electricity Bill: Rs.%.2f", total);

    return 0;
}

